# Local development values. They are accepted ONLY with CELINE_ENV=dev in the process
# environment; unset means hardened, and the service then refuses to start with the dev
# database password, a client secret equal to the client id, or an unset OIDC
# issuer/JWKS. `task run` exports CELINE_ENV=dev itself.
# CELINE_ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:15432/flexibility
CELINE_OIDC_BASE_URL=http://keycloak.celine.localhost/realms/celine
CELINE_OIDC_JWKS_URI=http://keycloak.celine.localhost/realms/celine/protocol/openid-connect/certs
CELINE_OIDC_AUDIENCE=svc-flexibility
LOG_LEVEL=INFO
